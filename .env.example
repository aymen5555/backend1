### Copy this file to `.env` and fill private values (do NOT commit secrets)

# Application
APP_NAME=PlaySpace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Mail configuration
# To use Gmail SMTP with an App Password:
# 1) Create an App Password in your Google Account (Security → App passwords)
# 2) Paste the 16-character app password into MAIL_PASSWORD in your local `.env`
# 3) Do NOT commit your `.env` to version control.

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password-here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=aymencharf55@gmail.com
MAIL_FROM_NAME="PlaySpace"

# Other services (AWS, Redis, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
